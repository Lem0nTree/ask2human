# Application and backend
# Full URL including https://; must be reachable for World callbacks.
APP_URL=
# Local PostgreSQL for development. Replace DATABASE_URL when moving online.
POSTGRES_USER=groundwork
POSTGRES_PASSWORD=
POSTGRES_DB=groundwork
DATABASE_URL=
# Optional explicit production runtime override (configured privately in Vercel).
ASK2HUMAN_DATABASE_URL=
# Optional local reference to the hosted pooled URL; runtime uses DATABASE_URL.
NEON_DATABASE_URL=
# Direct hosted connection used only with MIGRATE_HOSTED=1.
DATABASE_URL_UNPOOLED=
SESSION_SECRET=

# Current integration: t2000's deployed mainnet USDC escrow.
SUI_NETWORK=mainnet
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
# Canonical mainnet Agent ID registry used by t2000 rejection.
T2000_AGENT_REGISTRY_ID=0xf41683aa9f4c121f34e4082c35180b0efdbd6d5293e3c88b1bcfa45ddf5c4119
# Optional endpoint references; use SUI_RPC_URL for the network selected above.
# SUI_RPC_URL_TESTNET=
# SUI_RPC_URL_DEVNET=

# World IDKit v4: app-only worker Selfie Check; no Orb credential required.
WORLD_ID_APP_ID=
WORLD_ID_RP_ID=
WORLD_ID_RP_SIGNING_KEY=
WORLD_ID_WORKER_ACTION=worker-enrollment
WORLD_ID_ENVIRONMENT=production
# Optional for staging tests only; never sent with production verification.
WORLD_ID_STAGING_VERIFICATION_TOKEN=
# Optional LOCAL setup credential; never expose in the app or browser.
# WORLD_DEVELOPER_API_KEY=

# World ID for Agents: sandbox OIDC owner authentication.
# The redirect URI must exactly match the registered HTTPS callback URL.
# Planned route: https://<your-domain>/auth/world/callback
WORLD_AGENTS_ISSUER=https://sandbox.auth.world.org
WORLD_AGENTS_CLIENT_ID=
WORLD_AGENTS_CLIENT_SECRET=
WORLD_AGENTS_REDIRECT_URI=

# Archived custom testnet escrow only; unused by the t2000 mainnet integration.
SUI_ESCROW_PACKAGE_ID=
SUI_ESCROW_COIN_TYPE=0x2::sui::SUI

# Private S3 bucket for worker evidence. Use the bucket's actual AWS Region.
AWS_REGION=
S3_BUCKET=
# Optional for local AWS CLI/SDK credentials; uncomment if using a named profile.
# AWS_PROFILE=
# On Vercel, configure a server-side AWS credential provider instead of a local profile.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Demo wallet signing keys are LOCAL trial inputs only. Never configure them
# in Vercel or any NEXT_PUBLIC_ variable. App users sign in their own wallets.
