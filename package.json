{
  "name": "ask2human",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test-concurrency=1 --test tests/*.test.ts",
    "test:sui": "tsx scripts/sui-escrow-test.ts",
    "sui:wallets": "tsx scripts/sui-wallets.ts",
    "sui:publish": "tsx --env-file=.env scripts/sui-publish.ts",
    "sui:trial": "tsx --env-file=.env scripts/sui-trial.ts",
    "t2000:trial": "tsx scripts/t2000-trial.ts",
    "db:migrate": "tsx --env-file=.env scripts/db-migrate.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@mysten/dapp-kit-react": "^2.1.35",
    "@mysten/sui": "^2.33.1",
    "@t2000/sdk": "11.7.0",
    "@worldcoin/idkit": "^4.3.0",
    "@worldcoin/idkit-core": "^4.3.0",
    "jose": "^6.2.12",
    "next": "^16.3.6",
    "openid-client": "^6.8.8",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
